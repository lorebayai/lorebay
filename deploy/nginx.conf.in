# Binary prefixes keep compressed IPv6 spellings in the same /64 budget.
map $binary_remote_addr $lorebay_caller {
    default $binary_remote_addr;
    "~^(?s)(?<lorebay_ipv6_prefix>.{8}).{8}$" $lorebay_ipv6_prefix;
}
map "$request_method:$uri" $lorebay_login {
    default "";
    "POST:/api/v1/sign-in" $lorebay_caller;
}
map "$request_method:$uri" $lorebay_registration {
    default "";
    "POST:/oauth/register" $lorebay_caller;
}
map "$request_method:$uri" $lorebay_device {
    default "";
    "POST:/oauth/device" $lorebay_caller;
}
map "$request_method:$uri" $lorebay_verification {
    default "";
    "POST:/api/v1/device-sign-in-request" $lorebay_caller;
    "POST:/api/v1/device-sign-in-decision" $lorebay_caller;
}
limit_req_zone $lorebay_login zone=lorebay_login:10m rate=10r/m;
# nginx's minimum rate is 1r/m; lorebayd's default registration budget is 10r/h.
limit_req_zone $lorebay_registration zone=lorebay_registration:10m rate=1r/m;
limit_req_zone $lorebay_device zone=lorebay_device:10m rate=10r/m;
limit_req_zone $lorebay_verification zone=lorebay_verification:10m rate=10r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @DOMAIN@;
    ssl_certificate @TLS@/live/certificate.pem;
    ssl_certificate_key @TLS@/live/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # SNI and Host must both name this deployment, even with another default site.
    if ($ssl_server_name != @DOMAIN@) { return 444; }
    if ($host != @DOMAIN@) { return 444; }
    limit_req_status 429;
    limit_req zone=lorebay_login burst=9 nodelay;
    limit_req zone=lorebay_registration burst=9 nodelay;
    limit_req zone=lorebay_device burst=9 nodelay;
    limit_req zone=lorebay_verification burst=9 nodelay;
    client_max_body_size @UPLOAD_LIMIT@;
    client_body_timeout 60s;

    location / {
        proxy_pass http://@UPSTREAM@;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        # Chunked uploads otherwise buffer despite proxy_request_buffering off.
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
