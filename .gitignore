# =============================================================================
# Repo-local tooling
# =============================================================================

.moon/cache/
.moon/docker/

# Local git worktrees
.worktrees/

# Superpowers workspace state and design/plan docs (kept local)
.superpowers/
docs/superpowers/

# =============================================================================
# Rust
# =============================================================================

# Cargo build output (Cargo.lock is committed: this repo ships a binary)
target/
/debug/

# Backup files generated by rustfmt
**/*.rs.bk

# rustc dumps stack traces here when hitting an internal compiler error
rustc-ice-*.txt

# LLVM source-based coverage
*.profraw
*.profdata
lcov.info

# =============================================================================
# Node / TypeScript / Next.js
# =============================================================================

# Dependencies
node_modules/
.pnpm-store/

# Package manager logs
npm-debug.log*
pnpm-debug.log*

# TypeScript incremental build info
*.tsbuildinfo

# Next.js
.next/
out/
next-env.d.ts

# Lint caches
.eslintcache

# Playwright
test-results/
playwright-report/

# =============================================================================
# Local data and secrets
# =============================================================================

.env
.env.*

# =============================================================================
# Editors & IDEs
# =============================================================================

# JetBrains (RustRover, WebStorm, ...)
.idea/

# VS Code: ignore local state, keep shared workspace config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# =============================================================================
# OS files
# =============================================================================

.DS_Store
._*
Thumbs.db
desktop.ini

# =============================================================================
# Logs
# =============================================================================

*.log
