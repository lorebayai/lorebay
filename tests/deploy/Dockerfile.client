FROM debian:12
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-venv chromium libnss3-tools openssh-client curl openssl ca-certificates \
    && python3 -m venv /opt/browser \
    && /opt/browser/bin/pip install --no-cache-dir playwright==1.56.0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/browser/bin:${PATH}"
COPY client.py /driver.py
CMD ["sleep", "infinity"]
