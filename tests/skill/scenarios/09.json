        {
          "label": "subagent creates no second task",
          "query": {
            "cli": [
              "task",
              "list",
              "{space}"
            ]
          },
          "op": "count",
          "value": 1
        },
        {
          "label": "parent task completes",
          "query": {
            "cli": [
              "task",
              "list",
              "{space}"
            ],
            "path": [
              0,
              "state"
            ]
          },
          "op": "equals",
          "value": "done"
        }
      ]
    },
    {
      "action": {
        "query": {
          "cli": [
            "task",
            "list",
            "{space}"
          ],
          "path": [
            0
          ]
        },
        "save": {
          "task": [
            "key"
          ],
          "task_id": [
            "task_id"
          ]
        }
      },
      "expect": []
    },
    {
      "action": {
        "cli": [
          "task",
          "show",
          "{space}",
          "{task}"
        ]
      },
      "expect": [
        {
          "label": "parent records delegated work",
          "query": {
            "cli": [
              "task",
              "scratchpad",
              "{space}",
              "{task}"
            ]
          },
          "op": "at_least",
          "value": 3
        },
        {
          "label": "combined result is present",
          "query": {
            "cli": [
              "task",
              "show",
              "{space}",
              "{task}"
            ],
            "path": [
              "result"
            ]
          },
          "op": "nonempty",
          "value": true
        }
      ]
    }
  ],
  "questions": [
    "Did the harness actually start a subagent, and does its output contain the requested risk analysis?",
    "Did the parent record that work in its own task checkpoints, without a subagent task?"
